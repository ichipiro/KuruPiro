{
  "name": "kuru-piro-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute kurupiro-db --local --file=./drizzle/0000_absent_maverick.sql",
    "db:migrate:prod": "wrangler d1 execute kurupiro-db --file=./drizzle/0000_absent_maverick.sql",
    "db:push:local": "drizzle-kit push --dialect=sqlite --url=.wrangler/state/v3/d1/miniflare-D1DatabaseObject/kurupiro-db.sqlite",
    "test": "vitest",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "test:e2e": "vitest run src/__tests__/e2e",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "fmt": "prettier --write \"src/**/*.ts\"",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@types/pbf": "^3.0.5",
    "drizzle-orm": "^0.44.7",
    "fflate": "^0.8.1",
    "gtfs-realtime-bindings": "^1.1.1",
    "hono": "^4.10.1",
    "pbf": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "@tsconfig/recommended": "^1.0.3",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.16",
    "drizzle-kit": "^0.31.7",
    "prettier": "^3.2.5",
    "typescript": "^5.4.2",
    "vitest": "^4.0.16",
    "wrangler": "^4.42.1"
  }
}
